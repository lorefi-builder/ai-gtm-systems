# Point the UI at a Supabase project whose Postgres has the
# 01-postgres-gtm-schema migrations + seeds loaded. Works against either:
#   - Local Supabase (supabase start) with the schema applied
#   - A hosted Supabase project with the same schema applied
#
# The UI reads via the anon key and mutates via the service-role key inside
# server actions. The service-role key MUST stay server-only — it is never
# prefixed with NEXT_PUBLIC_.

# Public — used by RSC for SELECTs against gtm.agent_outputs (RLS allows the
# anon role to read pending rows in the demo schema).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...replace-me

# Server-only — used by approve/reject server actions. Has bypasses-RLS
# privileges, so do not expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-me
