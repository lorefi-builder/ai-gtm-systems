# Project Assessment Agent — environment template.
# Copy to .env and fill in. Do NOT commit the real .env.

# Supabase project REST endpoint, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# service_role key (bypasses RLS). SERVER-SIDE ONLY — never expose to a client.
SUPABASE_SERVICE_KEY=

# Anthropic API key for the assessment/extraction agents (later blocks).
ANTHROPIC_API_KEY=
