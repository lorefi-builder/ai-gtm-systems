# Anthropic API key for the Claude model that generates subject-line proposals.
ANTHROPIC_API_KEY=

# Postgres connection string. The agent should authenticate as the gtm_agent
# role (see ../01-postgres-gtm-schema). gtm_agent can SELECT lead/experiment
# state and INSERT into gtm.agent_outputs with status='pending_review'; it
# CANNOT approve or ship its own output. The database enforces that.
DATABASE_URL=postgres://gtm_agent@localhost:5432/lorefi_gtm

# Stored in agent_outputs.agent_name. Must be one of the values allowed by the
# CHECK constraint on that column (currently: email_ops, content_ops).
AGENT_NAME=email_ops

# When true, the agent prints its proposed payload to stdout and exits without
# writing to the database. Flip to "false" only when you actually want
# pending_review rows to land in gtm.agent_outputs.
DRY_RUN=true

# Minimum number of exposures a losing variant needs before we treat its open
# rate as a real signal (not noise from tiny n).
MIN_SAMPLE_SIZE=100

# Variants with an observed open rate strictly below this number are eligible
# for new proposals. 0.18 = 18%.
OPEN_RATE_THRESHOLD=0.18
